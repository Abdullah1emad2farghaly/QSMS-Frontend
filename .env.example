# Copy to .env.local (never commit real values). Only VITE_* variables reach the browser,
# so never put secrets here.

# Origin of the QSMS backend API, WITHOUT the /api/v1 prefix (endpoint paths already include it),
# e.g. https://api.example.com. Intentionally empty: set it once the real URL is known.
# While empty, any API request fails fast with a "misconfigured" error.
VITE_API_BASE_URL=

# Request timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT_MS=30000

# Default UI language when the user has no saved preference: ar | en (default: ar)
VITE_DEFAULT_LANGUAGE=ar
